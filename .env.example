# ── Server ──
PORT=4000
NODE_ENV=development

# ── Database (PostgreSQL) ──
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flowx_db"

# ── JWT ──
JWT_SECRET="change-this-to-a-random-64-char-string-in-production"
JWT_EXPIRES_IN="7d"

# ── SMS Gateway (Local PK) ──
# Choose one: jazz, telenor, or your provider
SMS_PROVIDER="jazz"
SMS_API_URL="https://api.example.com/sms/send"
SMS_API_KEY="your-sms-api-key-here"
SMS_SENDER_ID="FlowX"

# ── Admin (default seed) ──
ADMIN_PHONE="03158374442"
ADMIN_PASSWORD="ChangeMe123!"

# ── Frontend URL (CORS) ──
FRONTEND_URL="http://localhost:3000"

# ── Order assignment ──
# Seconds a vendor/rider has to accept an offered order before it passes to
# the next candidate. Clamped to 60-120 in code; default 90.
ACCEPT_WINDOW_SECONDS=90

# Seconds between background sweeps that retry orders whose vendor offer
# expired, or that ended up with no offer at all (e.g. every vendor in the
# zone was closed). Clamped to 30-600 in code; default 60.
ASSIGNMENT_SWEEP_INTERVAL_SECONDS=60

# ── Subscriptions ──
# Minutes between sweeps that turn due ACTIVE subscriptions into orders.
# Clamped to 5-1440 in code; default 15.
SUBSCRIPTION_CHECK_INTERVAL_MINUTES=15

# ── Payment Gateways ──
# Leave a provider's credentials unset to run it in DEV MODE: checkout is
# simulated locally through /api/payments/simulate instead of a real gateway,
# so the whole flow works without a merchant account. Fill these in and the
# same code talks to the real gateway — no code changes needed.
#
# Public base URL of THIS api, used to build the dev-mode redirect.
API_PUBLIC_URL="http://localhost:4000/api"

# JazzCash — Merchant Portal → Integration
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
# Sandbox by default; swap to the live URL when going live.
JAZZCASH_POST_URL="https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform"

# Easypaisa — Merchant Integration Guide. HASH_KEY must be exactly 16 chars.
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""
EASYPAISA_POST_URL="https://easypay.easypaisa.com.pk/easypay/Index.jsf"

# Safepay — dashboard → Developers. Register the webhook URL there as:
#   <API_PUBLIC_URL>/payments/callback/safepay
SAFEPAY_API_KEY=""
SAFEPAY_WEBHOOK_SECRET=""
SAFEPAY_API_URL="https://sandbox.api.getsafepay.com"
SAFEPAY_CHECKOUT_URL="https://sandbox.getsafepay.com/embedded"
SAFEPAY_ENVIRONMENT="sandbox"

# ── Error tracking (Sentry) ──
# Leave SENTRY_DSN unset to run in DEV MODE: nothing is sent anywhere and no
# Sentry account is needed. Set it in Railway to start collecting errors.
# Get the DSN from sentry.io → Project Settings → Client Keys (DSN).
SENTRY_DSN=""
# Defaults to NODE_ENV. Set explicitly to separate staging from production.
SENTRY_ENVIRONMENT=""
# Performance tracing sample rate, 0-1. Defaults to 0 (errors only) to keep
# within the free-tier quota. Try 0.1 if you need to chase slow endpoints.
SENTRY_TRACES_SAMPLE_RATE="0"
