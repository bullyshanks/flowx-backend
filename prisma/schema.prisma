// ═══════════════════════════════════════════════════════════
//  FlowX Database Schema
//  Generated for PostgreSQL with Prisma
// ═══════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────

enum Role {
  CUSTOMER
  VENDOR
  RIDER
  ADMIN
}

enum VendorStatus {
  PENDING // just registered, awaiting admin approval
  APPROVED
  REJECTED
  SUSPENDED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum FulfillmentType {
  SELF_PICKUP
  DELIVERY
}

enum OrderStatus {
  PENDING // just placed
  CONFIRMED // admin/vendor confirmed
  ASSIGNED // assigned to a vendor
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  JAZZCASH
  EASYPAISA
  BANK_TRANSFER
  CARD // routed through Safepay — the only card acquirer wired up (see payment.service)
}

// One attempt at collecting money for an order. An order can accumulate
// several: a customer who abandons the gateway and retries produces a new
// attempt each time, and keeping the failed ones is what makes "the money
// left my account but the order says unpaid" answerable later.
enum PaymentAttemptStatus {
  INITIATED // redirect handed to the customer, gateway hasn't reported back
  PAID
  FAILED
  CANCELLED // customer backed out at the gateway
}

enum PaymentProvider {
  JAZZCASH
  EASYPAISA
  SAFEPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum SubscriptionFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum LedgerEntryType {
  PRODUCT_VALUE
  RIDER_EARNING
  COMMISSION_DEDUCTED
  REFUND
  ADJUSTMENT
  SETTLEMENT_PAYOUT
  REFERRAL_BONUS // paid to a vendor who brought another vendor onto FlowX
}

enum SettlementStatus {
  PENDING
  APPROVED
  PAID
}

enum RefundStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum ReferralStatus {
  PENDING // referee signed up, hasn't completed a first order yet
  CREDITED // referee's first order delivered — referrer's bonus paid out
}

/// What was referred. Both settle on the referee's first DELIVERED order, but
/// "first order" means different things: for a CUSTOMER it's the first order
/// they placed, for a VENDOR the first one they fulfilled.
enum ReferralKind {
  CUSTOMER
  VENDOR
}

// ─── MODELS ─────────────────────────────────────────────────

model User {
  id         String  @id @default(uuid())
  name       String
  phone      String  @unique
  email      String? @unique
  password   String? // optional — guest orders allowed
  role       Role    @default(CUSTOMER)
  isVerified Boolean @default(false)

  // Customer-specific
  defaultAddress String?
  zoneId         String?
  zone           Zone?   @relation("UserZone", fields: [zoneId], references: [id])

  // Vendor-specific
  cnic           String?
  vendorStatus   VendorStatus? // null for non-vendors
  approvedAt     DateTime?
  rejectedReason String?
  codLimit       Decimal?      @db.Decimal(10, 2) // null = unlimited — shared gate for VENDOR and RIDER
  codLiability   Decimal       @default(0) @db.Decimal(10, 2) // running outstanding balance — shared for VENDOR and RIDER
  isFrozen       Boolean       @default(false) // admin can freeze financial activity — shared for VENDOR and RIDER

  // KYC (shared by VENDOR and RIDER)
  cnicFront String? // file URL
  cnicBack  String?
  selfieUrl String?
  kycStatus KycStatus @default(NOT_SUBMITTED)

  // Vendor-specific (new)
  businessName String?
  shopDetails  String?
  isOpen       Boolean @default(true) // vendor open/closed toggle
  stockStatus  Boolean @default(true) // in stock / out of stock

  // Rider-specific (new)
  vehicleDetails String?
  isOnline       Boolean @default(false) // online/offline toggle

  // Referral (customer-specific — every customer gets a shareable code;
  // referring a friend earns a wallet credit once the friend's first order
  // is delivered, see Referral model). Nullable since vendors/riders/admin
  // never get one, and existing customers are backfilled lazily on first
  // touch rather than in a migration.
  referralCode  String?  @unique
  referredById  String?
  referredBy    User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals     User[]   @relation("Referrals")
  walletBalance Decimal  @default(0) @db.Decimal(10, 2) // customer credit from referrals, spent as a checkout discount

  // Relations
  orders             Order[]            @relation("CustomerOrders")
  assignedOrders     Order[]            @relation("VendorOrders")
  offeredOrders      Order[]            @relation("OfferedVendorOrders")
  riderOrders        Order[]            @relation("RiderOrders")
  subscriptions      Subscription[]
  ledgerEntries      LedgerEntry[]
  settlements        Settlement[]
  riderLedgerEntries RiderLedgerEntry[]
  riderSettlements   RiderSettlement[]
  vendorProducts     VendorProduct[]
  refunds            Refund[]
  pushSubscriptions  PushSubscription[]
  referralsGiven     Referral[]         @relation("ReferralGiven")
  referralReceived   Referral?          @relation("ReferralReceived")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([role])
  @@index([vendorStatus])
}

model Zone {
  id       String  @id @default(uuid())
  name     String  @unique // e.g. "North Karachi", "Gulshan"
  city     String  @default("Karachi")
  isActive Boolean @default(true)

  users         User[]         @relation("UserZone")
  orders        Order[]
  subscriptions Subscription[]
  demand        ZoneDemand[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

/// One row per checkout turned away because no vendor covers the zone.
///
/// Without this a zone with no vendors is indistinguishable from a zone nobody
/// wants — both look like zero orders. This is the difference between the two,
/// and it is what says which of the eight uncovered zones to recruit first.
///
/// Deliberately holds no phone, name or address: it exists to count demand, not
/// to build a marketing list out of people we turned away.
model ZoneDemand {
  id     String @id @default(uuid())
  zoneId String
  zone   Zone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  /// ORDER or SUBSCRIPTION — a rejected subscription is a stronger signal than
  /// a one-off, since that customer wanted a standing delivery.
  source String

  createdAt DateTime @default(now())

  @@index([zoneId, createdAt])
}

model Product {
  id                  String   @id @default(uuid())
  name                String // e.g. "19L Dispenser Bottle"
  slug                String   @unique
  description         String?
  price               Decimal  @db.Decimal(10, 2) // in PKR
  unit                String // "bottle", "set of 6", "tank"
  minQuantity         Int      @default(1) // 3 for 19L, 4 for refill
  imageUrl            String?
  isActive            Boolean  @default(true)
  commissionPct       Decimal? @db.Decimal(5, 2) // null = use global default (20%)
  riderEarningPerUnit Decimal  @default(0) @db.Decimal(10, 2)
  hasRiderDelivery    Boolean  @default(true) // false for 1000L tank

  orderItems     OrderItem[]
  subscriptions  Subscription[]
  vendorProducts VendorProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([isActive])
}

// A vendor's own price + stock override for one catalog product. Absence of
// a row means the vendor sells it at Product.price and carries it in stock —
// this is an opt-out model, not opt-in, so existing vendors need no setup.
// Commission % and rider earning stay global/product-level (FlowX's own
// take-rate policy) — only the vendor's selling price and availability are
// per-vendor here.
model VendorProduct {
  id        String   @id @default(uuid())
  vendorId  String
  vendor    User     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price     Decimal? @db.Decimal(10, 2) // null = use Product.price
  inStock   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([vendorId, productId])
  @@index([productId])
}

model Order {
  id          String @id @default(uuid())
  orderNumber String @unique // e.g. FLW-2026-00001

  // Customer info (supports guest checkout)
  customerId   String?
  customer     User?   @relation("CustomerOrders", fields: [customerId], references: [id])
  guestName    String?
  guestPhone   String?
  guestAddress String?

  // Delivery
  zoneId           String
  zone             Zone      @relation(fields: [zoneId], references: [id])
  deliveryAddress  String
  deliveryDate     DateTime?
  deliveryTimeSlot String? // "Morning", "Evening"
  deliveryNotes    String?

  // Fulfillment
  fulfillmentType FulfillmentType @default(DELIVERY)

  // Vendor assignment — offer/accept flow: order is offered to one vendor at a
  // time (offeredVendorId); accepting sets vendorId and clears the offer.
  vendorId             String?
  vendor               User?     @relation("VendorOrders", fields: [vendorId], references: [id])
  offeredVendorId      String?
  offeredVendor        User?     @relation("OfferedVendorOrders", fields: [offeredVendorId], references: [id])
  vendorAcceptDeadline DateTime? // now() + accept window; expiry reassigns to next vendor
  assignedAt           DateTime?
  deliveredAt          DateTime?

  // Rider assignment (delivery orders only)
  riderId             String?
  rider               User?     @relation("RiderOrders", fields: [riderId], references: [id])
  riderAssignedAt     DateTime?
  riderAcceptDeadline DateTime? // now() + 60-120s, for the accept/reject timer

  // Pricing
  subtotal       Decimal @db.Decimal(10, 2)
  deliveryFee    Decimal @default(0) @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2) // referral signup discount or wallet balance applied at checkout
  total          Decimal @db.Decimal(10, 2)

  // Payment
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  paymentProof  String? // image URL of receipt
  transactionId String?

  // Status
  status OrderStatus @default(PENDING)

  // Subscription link (if from a subscription)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  items              OrderItem[]
  statusHistory      OrderStatusLog[]
  ledgerEntries      LedgerEntry[]
  riderLedgerEntries RiderLedgerEntry[]
  refunds            Refund[]
  payments           Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderNumber])
  @@index([status])
  @@index([zoneId])
  @@index([vendorId])
  @@index([offeredVendorId])
  @@index([riderId])
  @@index([customerId])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)

  @@index([orderId])
}

model OrderStatusLog {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  changedBy String? // userId who made the change
  notes     String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model Subscription {
  id         String  @id @default(uuid())
  customerId String
  customer   User    @relation(fields: [customerId], references: [id])
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  zoneId     String
  zone       Zone    @relation(fields: [zoneId], references: [id])

  quantity          Int
  frequency         SubscriptionFrequency
  preferredTimeSlot String?
  deliveryAddress   String
  paymentMethod     PaymentMethod

  status           SubscriptionStatus @default(ACTIVE)
  startDate        DateTime           @default(now())
  nextDeliveryDate DateTime?
  endDate          DateTime?

  // Sweep failure visibility — lastError is cleared on the next successful
  // run; without this a repeatedly-failing subscription looks identical to
  // a healthy one in the admin panel.
  lastError     String?
  lastAttemptAt DateTime?

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([nextDeliveryDate])
}

model CommissionSettings {
  id                   String   @id @default(uuid())
  defaultCommissionPct Decimal  @default(20) @db.Decimal(5, 2)
  /// Paid to whoever brought a new vendor on, once that vendor completes their
  /// first delivery. Admin-settable — see finance.updateCommissionSettings.
  vendorReferralReward Decimal  @default(500) @db.Decimal(10, 2)
  updatedAt            DateTime @updatedAt
}

model LedgerEntry {
  id          String          @id @default(uuid())
  vendorId    String
  vendor      User            @relation(fields: [vendorId], references: [id])
  orderId     String?
  order       Order?          @relation(fields: [orderId], references: [id])
  type        LedgerEntryType
  amount      Decimal         @db.Decimal(10, 2) // positive = credit to vendor, negative = debit
  description String?
  createdAt   DateTime        @default(now())

  @@index([vendorId])
  @@index([orderId])
}

model Settlement {
  id                String           @id @default(uuid())
  vendorId          String
  vendor            User             @relation(fields: [vendorId], references: [id])
  periodStart       DateTime
  periodEnd         DateTime
  totalProductValue Decimal          @db.Decimal(10, 2)
  totalRiderEarning Decimal          @db.Decimal(10, 2)
  totalCommission   Decimal          @db.Decimal(10, 2)
  netPayable        Decimal          @db.Decimal(10, 2) // can be negative if vendor owes FlowX (COD case)
  status            SettlementStatus @default(PENDING)
  paymentMethod     String?
  paymentReference  String?
  approvedAt        DateTime?
  paidAt            DateTime?
  createdAt         DateTime         @default(now())

  @@index([vendorId])
  @@index([status])
}

// Admin-initiated refunds (see order.controller.getOrder / finance.controller
// refund endpoints). No payment gateway exists — paying out is the same
// manual method+reference pattern as Settlement. Clawback fields record
// whether/how much was deducted from the vendor's or rider's ledger for this
// order at approval time; this is a business judgment call made per-refund,
// not automatic, since "customer changed mind" and "vendor sent a bad
// product" have different fault allocation.
model Refund {
  id         String  @id @default(uuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id])
  customerId String?
  customer   User?   @relation(fields: [customerId], references: [id])

  amount Decimal @db.Decimal(10, 2)
  reason String

  status RefundStatus @default(PENDING)

  clawbackVendor       Boolean  @default(false)
  clawbackRider        Boolean  @default(false)
  vendorClawbackAmount Decimal? @db.Decimal(10, 2)
  riderClawbackAmount  Decimal? @db.Decimal(10, 2)

  paymentMethod    String?
  paymentReference String?
  rejectedReason   String?

  approvedAt DateTime?
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([orderId])
  @@index([customerId])
  @@index([status])
}

model RiderLedgerEntry {
  id          String          @id @default(uuid())
  riderId     String
  rider       User            @relation(fields: [riderId], references: [id])
  orderId     String?
  order       Order?          @relation(fields: [orderId], references: [id])
  type        LedgerEntryType // reuses the existing enum: RIDER_EARNING, REFUND, ADJUSTMENT, SETTLEMENT_PAYOUT
  amount      Decimal         @db.Decimal(10, 2) // positive = credit to rider, negative = debit
  description String?
  createdAt   DateTime        @default(now())

  @@index([riderId])
  @@index([orderId])
}

model RiderSettlement {
  id               String           @id @default(uuid())
  riderId          String
  rider            User             @relation(fields: [riderId], references: [id])
  periodStart      DateTime
  periodEnd        DateTime
  totalEarning     Decimal          @db.Decimal(10, 2)
  netPayable       Decimal          @db.Decimal(10, 2)
  status           SettlementStatus @default(PENDING)
  paymentMethod    String?
  paymentReference String?
  approvedAt       DateTime?
  paidAt           DateTime?
  createdAt        DateTime         @default(now())

  @@index([riderId])
  @@index([status])
}

model Otp {
  id         String    @id @default(uuid())
  phone      String
  code       String // 6-digit code
  purpose    String // "register", "login", "verify"
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone, purpose])
  @@index([expiresAt])
}

// Web Push (VAPID) subscriptions — one row per browser/device a user has
// granted notification permission on. No Firebase/third-party account
// needed, same fire-and-forget shape as sms.service.js (see push.service.js).
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// One row per successful referral signup. PENDING until the referee's first
// order is delivered (mirrors vendor/rider ledger entries only crediting on
// delivery, not placement — avoids paying out on a cancelled first order),
// then CREDITED once the referrer's walletBalance bonus is applied.
model Referral {
  id              String         @id @default(uuid())
  referrerId      String
  referrer        User           @relation("ReferralGiven", fields: [referrerId], references: [id])
  refereeId       String         @unique
  referee         User           @relation("ReferralReceived", fields: [refereeId], references: [id])
  kind            ReferralKind   @default(CUSTOMER)
  referrerBonus   Decimal        @default(50) @db.Decimal(10, 2)
  /// Always 0 for VENDOR referrals — a new vendor gets orders, not a discount.
  refereeDiscount Decimal        @default(50) @db.Decimal(10, 2)
  discountUsed    Boolean        @default(false)
  status          ReferralStatus @default(PENDING)
  createdAt       DateTime       @default(now())
  creditedAt      DateTime?

  @@index([referrerId])
  @@index([status])
  @@index([kind, status])
}

// A single attempt at collecting money through a gateway. Written when the
// customer is handed a redirect, updated when the gateway reports back.
//
// Order.paymentStatus stays the field the rest of the app reads — this table
// is the evidence behind it. rawCallback keeps the gateway's own words
// verbatim, because reconciling a disputed payment months later against a
// provider's dashboard is impossible from a status enum alone.
model Payment {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider PaymentProvider
  amount   Decimal         @db.Decimal(10, 2)
  status   PaymentAttemptStatus @default(INITIATED)

  // Our reference sent to the gateway. Unique because gateways key their
  // idempotency on it, and a collision would let one order's callback settle
  // another order.
  reference String @unique

  // The gateway's own identifier, only known once it responds.
  providerTxnId String?

  // Verbatim callback body, for reconciliation and dispute handling.
  rawCallback Json?

  failureReason String?
  paidAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([providerTxnId])
}
